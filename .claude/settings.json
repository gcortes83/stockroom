{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(openspec:*)",
      "Bash(pnpm:*)",
      "Bash(npx prisma:*)",
      "Bash(npx playwright:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(curl -fsS http://localhost:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(git push --force:*)",
      "Bash(docker system prune:*)"
    ]
  }
}
