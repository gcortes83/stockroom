{
  "name": "@stockroom/payments",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json -w --preserveWatchOutput & node --env-file=dev.env --watch dist/main.js)",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:coverage": "vitest run -c vitest.coverage.config.ts --coverage"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@stockroom/contracts": "workspace:*",
    "@stockroom/platform": "workspace:*",
    "fastify": "5.11.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@testcontainers/postgresql": "11.14.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "3.2.7",
    "supertest": "7.3.1",
    "testcontainers": "11.14.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
